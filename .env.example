# Environment Variables for The Dream Machine

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Security & Encryption (Master Key for AES-GCM wrapping)
# Generate 32 bytes hex: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL + pgvector
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dream_machine
POSTGRES_DB=dream_machine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Redis (Queue and Task Backend)
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# MinIO (Local S3-Compatible Object Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=dream-assets
MINIO_USE_SSL=false

# LLM Providers (Free-First defaults)
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Speech & Audio
KOKORO_MODEL_PATH=./models/kokoro
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu

# Web App
NEXT_PUBLIC_API_URL=http://localhost:8000
